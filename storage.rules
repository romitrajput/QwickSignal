// Firebase Storage security rules for QwickSignal.
//
// This is a SEPARATE ruleset from firestore.rules (Firebase Storage and Firestore are each configured and
// published independently, even though they're both part of the same Firebase project) - to use it:
//   Firebase console -> Storage -> if you haven't already, click "Get started" once to provision the
//   default bucket -> Rules tab -> paste this file -> Publish.
// FIREBASE.storageBucket in app.js must match whatever bucket name the console shows you on that screen
// (normally "{projectId}.appspot.com" - "qwicksignal.appspot.com" here - update that constant if yours
// differs, e.g. if the project was created after Google's 2024 default-bucket naming change to
// "{projectId}.firebasestorage.app").
//
// Only one thing lives in this bucket today: ticket attachments (screenshots/files a signed-in user attaches
// to a bug or feedback report - see Tickets.uploadAttachment() in app.js). Mirrors the access shape of the
// qs_tickets Firestore collection in firestore.rules: a signed-in user can upload into their own folder but
// can never list or read anything back (not even their own prior uploads) through this ruleset - attachments
// are surfaced back to their owner only via the signed download URL stored on the ticket doc, which
// renderTicketAdmin() reads and links to. Only the app owner can read objects directly via Storage.
//
// OWNER_EMAIL below must exactly match the OWNER_EMAIL constant in app.js and in firestore.rules.

rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isOwner() {
      return request.auth != null && request.auth.token.email == 'rrrajput2101@gmail.com';
    }

    // ticket_attachments/{uid}/{ticketId}/{filename}
    // Path is fixed by Tickets.uploadAttachment() in app.js as `ticket_attachments/${Auth.uid}/${ticketId}/
    // ${Date.now()}_${safeName}` - a signed-in user may only write into their own {uid} folder, and only
    // small files (8 MB cap - matches TICKET_ATTACH_MAX_BYTES in app.js, enforced here too since a client-side
    // check alone is never real security, same note as elsewhere in this app's rules).
    match /ticket_attachments/{uid}/{ticketId}/{fileName} {
      allow read: if isOwner();
      allow write: if request.auth != null && request.auth.uid == uid &&
        request.resource.size <= 8 * 1024 * 1024;
      allow delete: if isOwner();
    }

    // Everything else in this bucket: closed by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
