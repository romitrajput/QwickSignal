# QwickSignal — environment variables
#
# Copy this file to .env for local runs (never commit the real .env).
# In production (GitHub Actions), these are set as repository Secrets and Variables
# instead — see pipeline.yml, which reads them from ${{ secrets.* }} / ${{ vars.* }}.
# Nothing here is ever sent to the browser except FIREBASE_API_KEY / FIREBASE_PROJECT_ID,
# which are Firebase's own public web config (safe by design — real protection is
# firestore.rules, not secrecy of this pair).

# ---- AI story analysis + daily briefing (Anthropic) ----
# Needed to summarise posts and write the daily briefing. Without it, the pipeline still
# runs in "free mode" using keyword-only classification.
ANTHROPIC_API_KEY=

# ---- Telegram (private channel reading, optional) ----
# Only needed if you read Telegram channels via the MTProto API rather than the public
# https://t.me/s/NAME web preview (which needs no credentials at all).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=

# ---- Telegram bot (pipeline status notifications, optional) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- X / Twitter (optional, paid API) ----
# The official X API has no free tier for search/read; leave blank and keep
# sources.yml's `x.enabled: false` unless you have a paid bearer token.
X_BEARER_TOKEN=

# ---- YouTube Data API v3 (Phase 2.5 — video intelligence) ----
# Free tier: 10,000 quota units/day. One video search costs 100 units, so about 100
# searches/day at no cost. Get a key at https://console.cloud.google.com/apis/credentials
# after enabling "YouTube Data API v3" on a project. Never expose this key in the
# frontend — it is used only server-side, inside the GitHub Action.
YOUTUBE_API_KEY=

# ---- Google Custom Search JSON API (headline images) ----
# Free tier: 100 queries/day. One search = one query, so about 100 stories/day get a photo
# search at no cost (image_intel.py's Budget stops just under that limit automatically).
# 1) console.cloud.google.com -> enable "Custom Search API" on a project -> Credentials -> API key.
# 2) programmablesearchengine.google.com/controlpanel/create -> "Search the entire web" -> Create,
#    then turn on "Image search" for it and copy its Search engine ID (that's GOOGLE_SEARCH_CX).
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# ---- Image OCR for image-only Telegram posts (image_ocr.py) ----
# No API key and nothing to set here - it runs locally via pytesseract (in requirements.txt) and is
# free. It DOES need the tesseract-ocr binary + language packs installed on whatever machine runs
# pipeline.py; pipeline.yml installs tesseract-ocr + tesseract-ocr-hin automatically in GitHub
# Actions. Running the pipeline locally instead? Install it yourself, e.g.:
#   Debian/Ubuntu:  sudo apt-get install tesseract-ocr tesseract-ocr-hin
#   macOS:          brew install tesseract tesseract-lang
# Without it, image-only posts are just skipped, same as before this feature existed - see
# ocr_enabled/ocr_languages under settings: in sources.yml to turn it off or change languages.

# ---- Firebase (Phase 3 — cross-device sync for Saved/Dismissed/Channels) ----
# This is the public web SDK config, not a secret. It is safe to commit and safe to ship
# to the browser; access control is entirely enforced by firestore.rules on the server
# side. Create a free Firebase project, enable Firestore, and copy these two values from
# Project settings → General → Your apps → SDK setup and configuration.
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=

# ---- Optional: link back to the deployed app from pipeline notifications ----
APP_URL=
