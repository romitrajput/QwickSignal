// QwickSignal: Firestore Security Rules
//
// Four trust models:
//   qs_sync/{code}      Guest mode. Anyone with the code can read/write (that's the sharing
//                       mechanism). Rules only stop abuse: wrong shape, oversized lists, extra fields.
//   qs_users/{uid}      Signed-in mode. Same shape as qs_sync, but keyed by real Firebase Auth uid;
//                       only that uid can read/write its own doc.
//   qs_channels/{name}  Linked Telegram channels. Anyone can create as "approved" (no review step).
//                       No client update. Delete is owner-only.
//   qs_config/defaults  Owner-curated default-channel list. Public read, owner-only write.
//   qs_push_subs/{id}   Web Push subscriptions, one per device. No login needed. Public get/list so
//                       the pipeline can send pushes; a device can delete its own subscription.
//   qs_tickets/{id}     Signed-in bug/feedback reports. Write-only for a normal visitor (create only,
//                       never read back). Owner-only get/list/update(status)/delete.
//   qs_archive/{id}     Permanent story record once feed.json's 24h window drops it. Public read,
//                       pipeline-only create, no update, owner-only delete.
//   qs_pulse/{companySlug}     Phase 1 sentiment pulse, PER COMPANY (not per story): public bull/bear
//   qs_pulse_votes/{id}        aggregate. Signed-in create (first vote) + update (increment, bounded
//                              below); per-voter dedup doc, scoped get only (never listable), keyed
//                              "<companySlug>_<uid>" - one vote per person per company, applying across
//                              every story about that company rather than needing a fresh vote per story.
//
// OWNER_EMAIL below must exactly match the OWNER_EMAIL constant in app.js (public by design - real
// protection is that only Firebase Auth can produce a signed token asserting that email, which a
// visitor can't forge).
//
// To use: Firebase console -> Firestore Database -> Rules -> paste this file -> Publish.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null && request.auth.token.email == 'rrrajput2101@gmail.com';
    }

    // BUG FIX: app.js has sent an investChannels field (linked company-news channels) on every save since
    // commit 084ed30, but it was never added to the hasOnly() lists below. Firestore rejects a write
    // OUTRIGHT when any field isn't allowed, so every save - companies, channels, saved stories, all of it -
    // was silently refused from that point on, for guests and signed-in accounts alike. The device's own
    // local copy hid this until sign-out cleared it. Any field app.js's Sync.snapshot() sends MUST be listed
    // in both blocks, or the whole document stops saving.
    match /qs_sync/{code} {
      allow get: if true;

      allow create, update: if
        code.matches('QS-[A-Z2-9]{4}-[A-Z2-9]{4}') &&
        request.resource.data.keys().hasOnly(['saved', 'dismissed', 'channels', 'reviewed', 'hiddenChannels', 'companies', 'investChannels']) &&
        request.resource.data.saved is list && request.resource.data.saved.size() <= 5000 &&
        request.resource.data.dismissed is list && request.resource.data.dismissed.size() <= 5000 &&
        request.resource.data.channels is list && request.resource.data.channels.size() <= 200 &&
        (!('reviewed' in request.resource.data) ||
          (request.resource.data.reviewed is list && request.resource.data.reviewed.size() <= 5000)) &&
        (!('hiddenChannels' in request.resource.data) ||
          (request.resource.data.hiddenChannels is list && request.resource.data.hiddenChannels.size() <= 200)) &&
        (!('companies' in request.resource.data) ||
          (request.resource.data.companies is list && request.resource.data.companies.size() <= 300)) &&
        (!('investChannels' in request.resource.data) ||
          (request.resource.data.investChannels is list && request.resource.data.investChannels.size() <= 200));

      allow delete: if false;
    }

    match /qs_users/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;

      allow create, update: if
        request.auth != null && request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['saved', 'dismissed', 'channels', 'reviewed', 'hiddenChannels', 'companies', 'investChannels']) &&
        request.resource.data.saved is list && request.resource.data.saved.size() <= 5000 &&
        request.resource.data.dismissed is list && request.resource.data.dismissed.size() <= 5000 &&
        request.resource.data.channels is list && request.resource.data.channels.size() <= 200 &&
        (!('reviewed' in request.resource.data) ||
          (request.resource.data.reviewed is list && request.resource.data.reviewed.size() <= 5000)) &&
        (!('hiddenChannels' in request.resource.data) ||
          (request.resource.data.hiddenChannels is list && request.resource.data.hiddenChannels.size() <= 200)) &&
        (!('companies' in request.resource.data) ||
          (request.resource.data.companies is list && request.resource.data.companies.size() <= 300)) &&
        (!('investChannels' in request.resource.data) ||
          (request.resource.data.investChannels is list && request.resource.data.investChannels.size() <= 200));

      allow delete: if false;
    }

    match /qs_channels/{name} {
      allow get, list: if true;

      allow create: if
        name.matches('[a-z0-9_]{5,32}') &&
        request.resource.data.channel is string &&
        request.resource.data.channel.lower() == name &&
        request.resource.data.status == 'approved' &&
        request.resource.data.added_by is string && request.resource.data.added_by.size() <= 128 &&
        request.resource.data.added_at is string;

      allow update: if false;
      allow delete: if isOwner();
    }

    match /qs_config/defaults {
      allow get: if true;
      allow create, update: if isOwner() &&
        request.resource.data.keys().hasOnly(['channels']) &&
        request.resource.data.channels is list &&
        request.resource.data.channels.size() <= 200;
      allow delete: if false;
    }

    match /qs_push_subs/{id} {
      allow get, list: if true;

      // min_imp/countries/quiet/tz_min/digest are this device's own alert preferences (Settings ->
      // Notifications; see parse_push_prefs()/sub_wants() in pipeline.py). All optional - a subscription
      // written before they existed stays valid and keeps the old "every story" behaviour.
      allow create, update: if
        id.matches('[A-Za-z0-9_-]{16,64}') &&
        request.resource.data.keys().hasOnly(['endpoint', 'p256dh', 'auth', 'created_at',
                                              'min_imp', 'countries', 'quiet', 'tz_min', 'digest']) &&
        request.resource.data.endpoint is string && request.resource.data.endpoint.size() <= 1024 &&
        request.resource.data.p256dh is string && request.resource.data.p256dh.size() <= 256 &&
        request.resource.data.auth is string && request.resource.data.auth.size() <= 64 &&
        request.resource.data.created_at is string &&
        (!('min_imp' in request.resource.data) ||
          request.resource.data.min_imp in ['Critical', 'High', 'Medium', 'Low']) &&
        (!('countries' in request.resource.data) ||
          (request.resource.data.countries is list && request.resource.data.countries.size() <= 60)) &&
        (!('quiet' in request.resource.data) || request.resource.data.quiet is bool) &&
        (!('tz_min' in request.resource.data) ||
          (request.resource.data.tz_min is int &&
           request.resource.data.tz_min >= -840 && request.resource.data.tz_min <= 840)) &&
        (!('digest' in request.resource.data) ||
          request.resource.data.digest in ['off', 'daily', 'weekly']);

      allow delete: if true;
    }

    match /qs_tickets/{id} {
      allow get, list: if isOwner();

      allow create: if
        request.auth != null &&
        id.matches('tk[a-z0-9]{10,40}') &&
        request.resource.data.keys().hasOnly(['kind', 'message', 'status', 'created_at', 'user_email', 'user_id', 'ticket_number', 'attachment_data', 'attachment_type', 'attachment_name']) &&
        request.resource.data.kind in ['bug', 'support', 'feedback'] &&
        request.resource.data.message is string && request.resource.data.message.size() > 0 &&
          request.resource.data.message.size() <= 4000 &&
        request.resource.data.status == 'open' &&
        request.resource.data.created_at is string &&
        request.resource.data.user_email is string && request.resource.data.user_email.size() <= 256 &&
        request.resource.data.user_id is string && request.resource.data.user_id == request.auth.uid &&
        request.resource.data.ticket_number is string && request.resource.data.ticket_number.size() <= 32 &&
        (!('attachment_data' in request.resource.data) ||
          (request.resource.data.attachment_data is string && request.resource.data.attachment_data.size() <= 820000 &&
           request.resource.data.attachment_type is string && request.resource.data.attachment_type.size() <= 100 &&
           request.resource.data.attachment_name is string && request.resource.data.attachment_name.size() <= 200));

      allow update: if isOwner() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
        request.resource.data.status in ['open', 'done'];

      allow delete: if isOwner();
    }

    match /qs_archive/{id} {
      allow get, list: if true;

      allow create: if
        id.matches('s[a-z0-9]{6,40}') &&
        request.resource.data.keys().hasOnly(['headline', 'excerpt', 'importance', 'country', 'companies', 'published', 'archived_at']) &&
        request.resource.data.headline is string && request.resource.data.headline.size() <= 300 &&
        request.resource.data.excerpt is string && request.resource.data.excerpt.size() <= 600 &&
        request.resource.data.importance in ['Critical', 'High', 'Medium', 'Low'] &&
        request.resource.data.country is string && request.resource.data.country.size() <= 64 &&
        request.resource.data.published is string &&
        request.resource.data.archived_at is string &&
        (!('companies' in request.resource.data) ||
          (request.resource.data.companies is list && request.resource.data.companies.size() <= 8));

      allow update: if false;
      allow delete: if isOwner();
    }

    // qs_pulse: public bull/bear aggregate, now PER COMPANY (not per story - the per-story design made
    // one stock look "mixed" whenever its several, unrelated news items each drew a different crowd
    // reaction, which wasn't a real signal about the company at all, just noise from the news being
    // chopped into separate stories - see Pulse.companySlug() in app.js). qs_pulse_votes: private
    // per-(company,user) dedup record, always written together from Pulse.vote() in app.js. The doc id in
    // both collections is a slugified company name (lowercase, [a-z0-9-] only - see companySlug()), never
    // a raw story id and never the raw company string, so voting merges correctly regardless of case/
    // punctuation and the id is always a valid Firestore document id.
    match /qs_pulse/{companySlug} {
      allow get, list: if true;

      // First voter creates the doc with exactly one of the two counts at 1, the other at 0.
      allow create: if
        request.auth != null &&
        request.resource.data.keys().hasOnly(['bull', 'bear']) &&
        request.resource.data.bull is int && request.resource.data.bull >= 0 && request.resource.data.bull <= 1 &&
        request.resource.data.bear is int && request.resource.data.bear >= 0 && request.resource.data.bear <= 1 &&
        request.resource.data.bull != request.resource.data.bear;

      // Later votes only ever move the counts in one of 4 legitimate shapes: new bull vote, new bear
      // vote, or a switch (+1 new choice, -1 old choice, same write). No abs() - plain equality instead.
      allow update: if
        request.auth != null &&
        request.resource.data.keys().hasOnly(['bull', 'bear']) &&
        request.resource.data.bull is int && request.resource.data.bull >= 0 &&
        request.resource.data.bear is int && request.resource.data.bear >= 0 &&
        ((request.resource.data.bull == resource.data.bull + 1 && request.resource.data.bear == resource.data.bear) ||
         (request.resource.data.bear == resource.data.bear + 1 && request.resource.data.bull == resource.data.bull) ||
         (request.resource.data.bull == resource.data.bull + 1 && request.resource.data.bear == resource.data.bear - 1) ||
         (request.resource.data.bear == resource.data.bear + 1 && request.resource.data.bull == resource.data.bull - 1));

      allow delete: if isOwner();
    }

    match /qs_pulse_votes/{id} {
      // Not public-read: scoped to the caller's own doc via the stored uid field. list is refused
      // outright (nothing needs it; an unscoped list would let anyone enumerate other people's votes).
      allow get: if request.auth != null && resource.data.uid == request.auth.uid;
      allow list: if false;

      // id is always "<companySlug>_<uid>" (Pulse.voteDocId() in app.js) - one doc per (company, voter),
      // so re-voting updates the SAME doc, and a person's one vote applies across every story about that
      // company rather than needing a fresh vote per headline. Checked via string concatenation, not
      // split()/index access.
      allow create, update: if
        request.auth != null &&
        request.resource.data.keys().hasOnly(['company_slug', 'uid', 'choice', 'voted_at']) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.company_slug is string && request.resource.data.company_slug.size() <= 80 &&
        id == request.resource.data.company_slug + '_' + request.auth.uid &&
        request.resource.data.choice in ['bull', 'bear'] &&
        request.resource.data.voted_at is string;

      allow delete: if false;
    }
  }
}
